# ------------------------------------------------------------------------------
# Enterprise Application Modernization Platform — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL (.gitignore enforced)
# ------------------------------------------------------------------------------

# Application
APP_NAME=ModernizationPlatform
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True

# Network Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Database Configuration (Development: SQLite | Production: PostgreSQL)
# Production Example: postgresql+asyncpg://app_user:StrongPassword123@postgres-host:5432/modernization_db
DATABASE_URL=sqlite+aiosqlite:///./modernization.db

# Distributed Redis Task Queue & Version Caching
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Workspace Execution Base Path
# WORKSPACE_BASE_PATH=/var/app/modernization-workspaces

# File Ingestion Limits
MAX_UPLOAD_SIZE_MB=1024
MAX_ARCHIVE_RATIO=50

# Logging & Audit
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=True
