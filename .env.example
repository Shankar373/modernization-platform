# Environment Configuration

# Application
APP_NAME=ModernizationPlatform
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://modernize:modernize@localhost:5432/modernization_db
POSTGRES_USER=modernize
POSTGRES_PASSWORD=modernize
POSTGRES_DB=modernization_db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Worker
WORKER_CONCURRENCY=2
WORKER_MAX_TASKS_PER_CHILD=10

# Sandbox / Execution
WORKSPACE_BASE_PATH=/tmp/modernization-workspaces
SANDBOX_ENABLED=true
SANDBOX_DOCKER_IMAGE=modernization-worker:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_TIMEOUT_SECONDS=600

# File upload limits
MAX_UPLOAD_SIZE_MB=4096
MAX_ARCHIVE_RATIO=50

# AI / LLM (optional — leave blank to disable)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# RAG (optional — Phase 5)
RAG_ENABLED=false
VECTOR_DB_URL=

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
